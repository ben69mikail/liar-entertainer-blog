  keywords="Kinderzauberer Gladbeck, Kinderzauberer in Gladbeck, Zauberer Gladbeck, Kindergeburtstag Gladbeck, Zaubershow Gladbeck, NRW"
  canonical="https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-gladbeck/"
  ogImage={heroImg}
  structuredData={structuredData}
>

  <!-- Hero Section -->
  <section class="relative overflow-hidden" style="min-height: 600px;">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url('${heroImg}'); background-position: center 20%;`}></div>
