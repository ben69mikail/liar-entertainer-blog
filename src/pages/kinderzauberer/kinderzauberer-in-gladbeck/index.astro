---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import karteImg from '../../../assets/images/home/clown-zauberer-gladbeck-karte.jpg';
import { Image } from 'astro:assets';
import GoogleReviews from '../../../components/GoogleReviews.astro';

const seoTitle = "Kinderzauberer Gladbeck | TOP Bewertet | Buchen";
const seoDescription = "Kinderzauberer in Gladbeck buchen ✓ Zaubershow für Kindergeburtstag & Events ✓ 400+ Bewertungen ✓ Ab 150€ ✓ Auch in Herne & Dortmund ✓ Jetzt anfragen!";
const heroImg = 'https://liar-entertainer.com/wp-content/uploads/2024/01/clown-zauberer-gladbeck-hero.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Kinderzauberer in Gladbeck",
  "description": "Kinderzauberer LIAR für Kindergeburtstag und Kinderevents in Gladbeck, NRW",
  "url": "https://liar-entertainer.com/kinderzauberer/kinderzauberer-in-gladbeck/",
  "serviceType": ["Kinderzauberer", "Zaubershow für Kinder"],
  "provider": {
    "@type": "LocalBusiness",
    "name": "Clown Zauberer LIAR",
    "url": "https://liar-entertainer.com",
    "telephone": "+491721517578"
  },
  "areaServed": { "@type": "City", "name": "Gladbeck" },
  "offers": { "@type": "Offer", "price": "150", "priceCurrency": "EUR" }
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet ein Kinderzauberer in Gladbeck?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die Kosten für einen Kinderzauberer in Gladbeck variieren je nach Art der Veranstaltung, Dauer der Show, Zuschauerzahl und Anfahrt. Für Kindergeburtstage biete ich Festpreise an. Kontaktieren Sie mich unverbindlich für ein individuelles Angebot – ich berate Sie gerne!"
      }
    },
    {
      "@type": "Question",
      "name": "Wie viel Platz braucht die Zaubershow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Für meine Zaubershow in Gladbeck benötige ich lediglich eine Fläche von 2×2 Metern – ohne lange Vorbereitungszeit! Ob Wohnzimmer, Partykeller, Garten, Kindergarten, Schule oder Eventlocation: Ich passe mich flexibel an Ihre Räumlichkeiten an."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange dauert die Zaubershow in Gladbeck?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Meine Zaubershow in Gladbeck dauert ab 30 Minuten und lässt sich flexibel an Ihre Veranstaltung anpassen. Perfekt für: Kindergeburtstag, Kita-Fest, Schulfest, Sommerfest, Firmenevent, Hochzeit, Kommunion oder Straßenfest. Die Show-Dauer stimme ich individuell auf Ihr Event ab."
      }
    }
  ]
};

const structuredData = [serviceSchema, faqSchema];
---

<BaseLayout
